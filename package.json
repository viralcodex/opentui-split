{
  "name": "opentui-split",
  "version": "0.1.0",
  "description": "Draggable, resizable split-pane primitive for OpenTUI with Core, React, and Solid adapters.",
  "keywords": [
    "layout",
    "opentui",
    "resizable",
    "split-pane",
    "splitpane",
    "terminal",
    "tui"
  ],
  "homepage": "https://github.com/viralcodex/opentui-split#readme",
  "bugs": {
    "url": "https://github.com/viralcodex/opentui-split/issues"
  },
  "license": "MIT",
  "author": "Aviral Shukla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viralcodex/opentui-split.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/react.js",
    "./dist/solid.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun test --preload @opentui/solid/preload ./tests/solid-children.solid.tsx",
    "test:dist": "bun scripts/test-dist.ts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "prepublishOnly": "bun run check && bun run build && bun run test:dist"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "@opentui/solid": "^0.5.9",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react": "^19.2.0",
    "solid-js": "^1.9.12",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "@opentui/solid": "^0.5.9"
  },
  "peerDependenciesMeta": {
    "@opentui/react": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  }
}
