{
  "name": "opentui-split",
  "version": "0.1.0",
  "description": "Draggable, resizable split-pane primitive for OpenTUI — packaged behavior with a copy-in, editable skin.",
  "license": "MIT",
  "author": "Aviral Shukla",
  "homepage": "https://github.com/viralcodex/opentui-split#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viralcodex/opentui-split.git"
  },
  "bugs": {
    "url": "https://github.com/viralcodex/opentui-split/issues"
  },
  "type": "module",
  "keywords": [
    "opentui",
    "tui",
    "split-pane",
    "splitpane",
    "resizable",
    "layout",
    "terminal"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "registry",
    "registry.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:dist": "bun scripts/test-dist.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build && bun run test:dist"
  },
  "peerDependencies": {
    "@opentui/core": "^0.5.9"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "@opentui/solid": "^0.5.9",
    "@types/bun": "latest",
    "@types/node": "^26.4.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "solid-js": "^1.9.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  }
}
